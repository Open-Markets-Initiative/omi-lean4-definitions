  dsimp only
  rw [List.append_assoc, decodeUIntLE_encodeUIntLE, some_bind]
  dsimp only
  rw [decodeMany_bounded 1 Participant.encode Participant.decode Participant.decode_encode, some_bind]
  dsimp only
  rw [dite_eq_left message.participant.length_lt]
  rfl

